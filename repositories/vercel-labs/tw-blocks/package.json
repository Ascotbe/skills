{
  "name": "tw-blocks",
  "version": "4.0.0",
  "private": true,

  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:docs": "turbo run dev --filter=docs",
    "dev:dashboard": "turbo run dev --filter=dashboard",
    "dev:design-tool": "turbo run dev --filter=design-tool",
    "dev:editor-3d": "turbo run dev --filter=editor-3d",
    "dev:ui-analyzer": "turbo run dev --filter=ui-analyzer",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules .turbo"
  },
  "devDependencies": {
    "turbo": "^2.5.4"
  },
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=18.0.0"
  }
}

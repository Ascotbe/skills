{
  "name": "dev3000",
  "version": "0.0.179-canary",
  "description": "Agent-first local web debugging runtime with unified server and browser context",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "dev3000": "./bin/dev3000",
    "d3k": "./bin/dev3000"
  },
  "files": [
    "bin/",
    "dist/",
    "src/tui-interface-impl.tsx",
    "README.md"
  ],
  "scripts": {
    "build": "./node_modules/@typescript/native/bin/tsc && mkdir -p dist/src && cp src/loading.html dist/src/ && cp src/tui-interface-impl.tsx dist/src/ && rm -rf dist/skills && cp -r src/skills dist/",
    "typegen": "./scripts/typegen.sh",
    "typecheck": "./node_modules/@typescript/native/bin/tsc --noEmit && bun run --filter '*' typecheck",
    "format": "biome format --write .",
    "lint": "biome check src www scripts --vcs-use-ignore-file=true",
    "lint:fix": "biome check --write src www scripts",
    "test": "vitest run",
    "test-postinstall": "tsx scripts/test-postinstall.ts",
    "test-release": "./scripts/test-release.sh",
    "canary:smoke": "bun run scripts/canary-smoke-test.ts",
    "build:skill-runner-shell": "bun run scripts/build-skill-runner-shell-artifact.ts",
    "_postinstall": "node scripts/check-install.js || exit 0",
    "_prepare": "husky",
    "release": "./scripts/release.sh",
    "canary": "./scripts/canary.sh",
    "build:binaries": "bun run scripts/build-binaries.ts",
    "smoke:skill-runner-install": "bun run scripts/smoke-skill-runner-install.ts"
  },
  "keywords": [
    "nextjs",
    "ai",
    "development",
    "chrome-devtools-protocol",
    "cdp",
    "browser-monitoring",
    "debugging",
    "claude"
  ],
  "dependencies": {
    "@opentui/core": "0.4.5",
    "agent-browser": "0.33.0",
    "chalk": "^6.0.0",
    "commander": "15.0.0",
    "ink": "7.1.1",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ora": "9.4.1",
    "package-manager-detector": "^1.8.0",
    "portless": "0.15.4",
    "react": "19.2.8",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/ws": "^8.18.1",
    "husky": "^9.1.7",
    "tsx": "^4.23.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "^6.0.2",
    "vitest": "4.1.10"
  },
  "optionalDependencies": {
    "@d3k/darwin-arm64": "0.0.179-canary",
    "@d3k/linux-x64": "0.0.179-canary",
    "@d3k/windows-x64": "0.0.179-canary",
    "@opentui/core-linux-x64": "0.4.5"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vercel-labs/dev3000.git"
  },
  "author": "Lindsey Simon <lindsey@vercel.com>",
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "www"
  ],
  "overrides": {
    "postcss": "8.5.15"
  }
}

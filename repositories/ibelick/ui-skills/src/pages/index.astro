---
import Layout from "../layouts/Layout.astro";
import { skills } from "../data/skills";
import Button from "../ui/button.astro";
import AgentStartHere from "../ui/agent-start-here.astro";
import SkillCard from "../ui/skill-card.astro";

const MAX_SKILLS = 20;

const FEATURED_PATH_SLUGS = [
  "ibelick/ui-skills-root",
  "ibelick/improve-ui",
  "anthropics/frontend-design",
  "mengto/design-taste-frontend",
  "emilkowalski/improve-animations",
  "millionco/improve-react",
  "shadcn/improve",
  "shadcn-ui/shadcn",
  "jakubkrehel/better-ui",
  "0xdesign/design-lab",
  "nextlevelbuilder/ui-ux-pro-max",
  "dammyjay93/interface-design",
  "raphaelsalaja/12-principles-of-animation",
  "pbakaus/impeccable",
  "bencium/bencium-innovative-ux-designer",
  "leonxlnx/gpt-tasteskill",
  "antfu/web-design-guidelines",
  "rams/rams",
  "wshobson/interaction-design",
  "addyosmani/frontend-ui-engineering",
] as const;

const skillByPathSlug = new Map(skills.map((skill) => [skill.pathSlug, skill]));
const isDefined = <T,>(value: T | undefined): value is T => value !== undefined;

const displayedSkills = FEATURED_PATH_SLUGS.map((pathSlug) =>
  skillByPathSlug.get(pathSlug),
)
  .filter(isDefined)
  .slice(0, MAX_SKILLS)
  .map((skill) => {
    const owner = skill.sourceKey ?? "ibelick";

    return {
      ...skill,
      owner,
      ownerLabel: skill.sourceLabel ?? "Ibelick",
      avatarUrl: `https://github.com/${owner}.png?size=40`,
    };
  });
---

<Layout
  title="UI Skills for Design Engineers | UI Skills"
  description="UI Skills is a collection of design-engineering skills for accessibility, motion, frontend craft, and interface quality."
>
  <div
    class="relative flex min-h-dvh flex-col items-center justify-end px-0 sm:px-4"
  >
    <div class="relative mt-20 w-full max-w-3xl sm:px-0">
      <div class="mx-auto flex w-full flex-col gap-14">
        <div class="px-4 sm:px-0">
          <h1 class="sr-only">UI Skills</h1>
          <div class="relative inline-block overflow-hidden">
            <pre
              aria-hidden="true"
              class="text-parchment-500 font-['Fira_Mono'] text-[12px] leading-[110%] tracking-[-1.5px] whitespace-pre select-none lg:text-[12px]"
              style="font-weight: 300">{`
██╗   ██╗██╗    ███████╗██╗  ██╗██╗██╗     ██╗     ███████╗
██║   ██║██║    ██╔════╝██║ ██╔╝██║██║     ██║     ██╔════╝
██║   ██║██║    ███████╗█████╔╝ ██║██║     ██║     ███████╗
██║   ██║██║    ╚════██║██╔═██╗ ██║██║     ██║     ╚════██║
╚██████╔╝██║    ███████║██║  ██╗██║███████╗███████╗███████║
 ╚═════╝ ╚═╝    ╚══════╝╚═╝  ╚═╝╚═╝╚══════╝╚══════╝╚══════╝
              `}</pre>
            <pre
              aria-hidden="true"
              class="text-parchment-500/60 absolute top-0 left-0 font-['Fira_Mono'] text-[12px] leading-[110%] tracking-[-1.5px] whitespace-pre select-none lg:text-[12px]"
              style="font-weight: 300">{`
██    ██ ██     ███████ ██   ██ ██ ██      ██      ███████ 
██    ██ ██     ██      ██  ██  ██ ██      ██      ██      
██    ██ ██     ███████ █████   ██ ██      ██      ███████ 
██    ██ ██          ██ ██  ██  ██ ██      ██           ██ 
 ██████  ██     ███████ ██   ██ ██ ███████ ███████ ███████ 
`}</pre>
          </div>
          <p class="text-parchment-600 max-w-lg text-lg leading-snug">
            UI Skills is a collection of design-engineering skills to help
            humans and agents create better interfaces.
          </p>
        </div>

        <AgentStartHere />

        <div class="px-4 sm:px-0">
          <h2 class="text-parchment-900 text-base font-medium text-balance">
            Collection
          </h2>
          <div class="mt-3 grid gap-4 sm:grid-cols-2">
            {
              displayedSkills.map((skill) => (
                <SkillCard
                  href={`/skills/${skill.pathSlug}`}
                  slug={skill.slug}
                  description={skill.description}
                  ownerLabel={skill.ownerLabel}
                  avatarUrl={skill.avatarUrl}
                />
              ))
            }
          </div>
          <div class="mt-4 flex justify-center px-4 sm:px-0">
            <Button href="/skills"> See all skills </Button>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
